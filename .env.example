# Copia este fichero a .env y rellénalo. docker compose lo lee con `env_file`.

# --- Telegram ---
# El bot del inquilino de FEMIX_INQUILINO_ID. Opcional: los bots de otros inquilinos salen de sus
# perfiles (panel web). Lo que pongas aquí manda sobre el perfil de ese inquilino.
TELEGRAM_BOT_TOKEN=pon_aqui_el_token_de_botfather
# Quién puede hablar con el bot: IDs numéricos de Telegram separados por comas. Vacío = nadie.
# Para saber tu ID, escríbele al bot: te lo contesta, y sale en `docker compose logs femix-bot`
# como "Acceso denegado a usuario=...".
FEMIX_TELEGRAM_PERMITIDOS=

# --- Inquilino ---
# De quién es el bot de TELEGRAM_BOT_TOKEN: sus datos van en datos/{FEMIX_INQUILINO_ID}/
# (tareas, diario, memoria, índice RAG).
# Solo letras, dígitos, punto, guion y guion bajo; si no es válido, el bot no arranca.
FEMIX_INQUILINO_ID=default

# --- RAG por sentido (mejora 5): embeddings del Ollama del host ---
# Antes: ollama pull nomic-embed-text. Sin esto, búsqueda por palabras sueltas.
# FEMIX_EMBEDDINGS=ollama
# FEMIX_EMBEDDINGS_MODELO=nomic-embed-text

# --- Tool calling (Fase 5) ---
# Se enciende por inquilino, como las demás capacidades (panel o terminal):
#   docker compose exec femix-bot python -m femix.inquilino.capacidad TU_INQUILINO +tool_calling
# El modelo tiene que saber llamar a funciones (qwen2.5 sí). En CPU, cada mensaje que opera con
# datos hace 2-3 llamadas al modelo: un modelo complejo más grande solo para eso ayuda poco aquí.

# --- Zona horaria de los bots (fecha y hora en cada mensaje, reservas, recordatorios) ---
# FEMIX_ZONA_HORARIA=Europe/Madrid

# --- Base de datos (Fase 4): el Postgres del servicio femix-db de docker-compose.yml ---
# Obligatoria con docker compose. Solo letras y números (va dentro de una URL). Para generarla:
#   openssl rand -hex 24
# Ojo: se fija la primera vez que arranca femix-db; cambiarla después no cambia la de la base.
FEMIX_DB_CLAVE=
# Puerto en 127.0.0.1 del host (5433 para no chocar con otro Postgres de madre).
# FEMIX_DB_PUERTO=5433
# docker compose construye FEMIX_BASE_DATOS_URL con esto; fuera de Docker (CLI, tests) ponla tú:
# FEMIX_BASE_DATOS_URL=postgresql://femix:CLAVE@localhost:5433/femix

# --- LLM: Ollama en el host ---
# Con network_mode: host (docker-compose.yml), "localhost" dentro del contenedor ES el host,
# así que llega al Ollama de madre aunque escuche solo en 127.0.0.1:11434.
# Ojo: endpoint nativo /api/chat, no el compatible con OpenAI (/v1).
HUGIN_LLM_PROVEEDOR=ollama
HUGIN_LLM_MODELO=qwen2.5:3b
OLLAMA_URL=http://localhost:11434/api/chat

# Opcional: un modelo para respuestas rápidas y otro para tareas complejas (subagente).
# Sin ellas, todo usa HUGIN_LLM_MODELO.
# HUGIN_LLM_MODELO_RAPIDO=llama3.2
# HUGIN_LLM_MODELO_COMPLEJO=qwen3.5

# --- Alternativa: Ollama por su API compatible con OpenAI (/v1) ---
# HUGIN_LLM_PROVEEDOR=openai
# HUGIN_LLM_MODELO=qwen2.5:3b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# --- Alternativa: OpenAI de verdad ---
# HUGIN_LLM_PROVEEDOR=openai
# HUGIN_LLM_MODELO=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Panel web (en pruebas: solo con `docker compose --profile web up`) ---
FEMIX_WEB_ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio
# Por defecto solo en 127.0.0.1 (ssh -L 8000:localhost:8000 madre para entrar desde fuera).
# FEMIX_WEB_HOST=127.0.0.1
# FEMIX_WEB_PORT=8000

# --- SaaS (Fase 6) ---
# Con FEMIX_SAAS=1 se aplican planes, pruebas y límites de mensajes; la portada muestra los planes.
# Sin él, todo funciona como antes (plan interno, sin límites).
# FEMIX_SAAS=1
# Alta pública de clientes en /registro (14 días de prueba). Déjalo apagado hasta tenerlo claro.
# FEMIX_SAAS_REGISTRO=1
# Dominio público: Caddy saca el certificado HTTPS (docker compose --profile web --profile publico up -d).
# FEMIX_DOMINIO=femix.tudominio.es
# FEMIX_URL_PUBLICA=https://femix.tudominio.es
# Guardar los textos de los mensajes en el registro de actividad (0 = solo metadatos).
# FEMIX_REGISTRAR_MENSAJES=1

# --- Pagos con Stripe (opcional) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRECIO_BASICO=price_...
# STRIPE_PRECIO_PRO=price_...
